	"specs": {
		"soc": "ESP32-S3, Xtensa dual-core 32-bit LX7 with single precision FPU",
		"clock": 240,
		"memory": {
			"rom": 384,
			"sram": 512,
			"rtc-sram": 16,
			"flash": 16,
			"psram": 8,
			"note": "ROM/SRAM in KB, flash and PSRAM in MB; N16R8 means 16 MB quad SPI flash plus 8 MB octal SPI PSRAM"
		},
		"wireless": {
			"wifi": "802.11 b/g/n, 2.4 GHz (2412-2484 MHz), up to 150 Mbps, on-board PCB antenna",
			"bluetooth": "Bluetooth LE 5 and Bluetooth mesh, 125 kbps to 2 Mbps"
		},
		"input-voltage": {
			"min": 3,
			"nominal": 3.3,
			"max": 3.6,
			"note": "module supply; the development board also accepts 5 V through the USB Type-C connectors and regulates it on board"
		},
		"working-temperature": {
			"min": -40,
			"max": 65,
			"note": "R8 modules (octal PSRAM) are rated -40 to 65 C; enabling PSRAM ECC raises it to 85 C at the cost of 1/16 of the PSRAM size"
		},
		"communications": {
			"gpio": {
				"count": 36,
				"note": "on modules with octal PSRAM such as this one, IO35, IO36 and IO37 are used by the PSRAM and are NOT available for other uses; 4 strapping GPIOs"
			},
			"interfaces": [
				"SPI",
				"I2C",
				"I2S",
				"UART",
				"TWAI (CAN, ISO 11898-1 compatible)",
				"SD/MMC host",
				"LCD interface",
				"camera interface",
				"USB 2.0 OTG full speed",
				"USB Serial/JTAG",
				"MCPWM (motor control PWM)",
				"RMT remote control",
				"pulse counter",
				"LED PWM"
			],
			"analog": [
				"SAR ADC",
				"touch sensor",
				"internal temperature sensor"
			],
			"usb": "two USB Type-C connectors on the board: native USB OTG and USB Serial/JTAG (COM)",
			"note": "the MCPWM and pulse counter peripherals make this board a natural candidate for motor control and encoder reading"
		}
	}
